---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="This page does not exist." noindex>
  <div class="wrap not-found">
    <div>
      <p class="not-found__code">404 / NOT FOUND</p>
      <h1>The page fell through the grate.</h1>
      <p>
        There is nothing at this address. It may have moved, or it may never have existed. The
        drain is still down there.
      </p>
      <a class="btn btn--accent" href="/">Back to the index</a>
    </div>
  </div>
</Base>
