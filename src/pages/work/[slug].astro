---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseVisual from '../../components/CaseVisual.astro';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: work[index - 1] ?? null,
      next: work[index + 1] ?? null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const { title, kicker, dek, period, category, stack, status } = entry.data;
---

<Base title={title} description={dek} ogType="article">
  <article>
    <header class="case-head">
      <div class="wrap">
        <p class="case-kicker">{category} · {period}</p>
        <h1 class="case-title">{title}</h1>
        <p class="case-dek">{kicker}. {dek}</p>
        <dl class="case-meta">
          <div>
            <dt class="meta-label">Period</dt>
            <dd class="meta-value">{period}</dd>
          </div>
          <div>
            <dt class="meta-label">Category</dt>
            <dd class="meta-value">{category}</dd>
          </div>
          <div>
            <dt class="meta-label">Status</dt>
            <dd class="meta-value">{status}</dd>
          </div>
          <div>
            <dt class="meta-label">Stack</dt>
            <dd class="meta-value">{stack.join(' · ')}</dd>
          </div>
        </dl>
      </div>
    </header>

    <div class="wrap">
      <CaseVisual slug={entry.id} />
      <div class="prose case-body">
        <Content />
      </div>

      <nav class="post-nav" aria-label="Project navigation">
        <div>
          {
            prev && (
              <a href={`/work/${prev.id}/`}>
                <span class="post-nav__label">Previous project</span>
                <span class="post-nav__title">{prev.data.title}</span>
              </a>
            )
          }
        </div>
        <div class="post-nav__next">
          {
            next && (
              <a href={`/work/${next.id}/`}>
                <span class="post-nav__label">Next project</span>
                <span class="post-nav__title">{next.data.title}</span>
              </a>
            )
          }
        </div>
      </nav>
    </div>
  </article>
</Base>
