---
import Base from '../../layouts/Base.astro';
---

<Base title="Admin" description="Private control room." noindex>
  <header class="page-head">
    <div class="wrap">
      <p class="page-kicker">Private / noindex</p>
      <h1 class="page-title">Control room.</h1>
      <p class="page-lede">
        Guestbook moderation, private messages, and page counters. Password protected; there is no
        public account system.
      </p>
    </div>
  </header>

  <div class="wrap page-body">
    <div class="admin-wrap">
      <section class="admin-card admin-login" id="admin-login">
        <form class="form" id="login-form" style="max-width: none;">
          <div class="field">
            <label for="password">Password</label>
            <input id="password" name="password" type="password" required autocomplete="current-password" />
          </div>
          <div class="form-foot">
            <button class="btn btn--accent" type="submit">Sign in</button>
          </div>
          <p class="form-status" id="login-status" role="status" aria-live="polite"></p>
        </form>
      </section>

      <section id="admin-app" hidden>
        <div class="admin-stats" id="admin-stats"></div>

        <div class="admin-tabs" role="tablist" aria-label="Admin sections">
          <button class="admin-tab" type="button" role="tab" data-tab="guestbook" aria-selected="true">Guestbook</button>
          <button class="admin-tab" type="button" role="tab" data-tab="messages" aria-selected="false">Messages</button>
          <button class="admin-tab" type="button" role="tab" data-tab="pages" aria-selected="false">Pages</button>
          <button class="admin-tab" type="button" id="logout" style="margin-left: auto;">Sign out</button>
        </div>

        <div class="admin-panel admin-card" data-panel="guestbook">
          <div id="guestbook-table"></div>
        </div>
        <div class="admin-panel admin-card" data-panel="messages" hidden>
          <div id="messages-table"></div>
        </div>
        <div class="admin-panel admin-card" data-panel="pages" hidden>
          <div id="pages-table"></div>
        </div>

        <p class="form-status" id="admin-status" role="status" aria-live="polite"></p>
      </section>
    </div>
  </div>

  <script is:inline>
    (function () {
      var loginSection = document.getElementById('admin-login');
      var app = document.getElementById('admin-app');
      var loginForm = document.getElementById('login-form');
      var loginStatus = document.getElementById('login-status');
      var adminStatus = document.getElementById('admin-status');
      var overview = null;

      function el(tag, className, text) {
        var node = document.createElement(tag);
        if (className) node.className = className;
        if (text !== undefined) node.textContent = text;
        return node;
      }

      function setStatus(node, message, state) {
        if (!node) return;
        node.textContent = message || '';
        node.setAttribute('data-state', state || '');
      }

      function showLogin() {
        loginSection.hidden = false;
        app.hidden = true;
      }

      function showApp() {
        loginSection.hidden = true;
        app.hidden = false;
      }

      function formatTime(value) {
        try {
          return new Intl.DateTimeFormat('en-GB', {
            day: '2-digit',
            month: 'short',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
          }).format(new Date(value));
        } catch (error) {
          return value;
        }
      }

      function api(path, options) {
        return fetch(path, options || {}).then(function (response) {
          if (response.status === 401 && path.indexOf('/login') === -1) {
            showLogin();
            throw new Error('Session expired. Sign in again.');
          }
          return response.json().then(function (body) {
            if (!response.ok) throw new Error(body && body.error ? body.error : 'Request failed.');
            return body;
          });
        });
      }

      function statCard(value, label) {
        var card = el('div', 'stat');
        card.appendChild(el('div', 'stat__value', String(value)));
        card.appendChild(el('div', 'stat__label', label));
        return card;
      }

      function renderStats(data) {
        var target = document.getElementById('admin-stats');
        target.textContent = '';
        target.appendChild(statCard(data.total_views, 'Total views'));
        target.appendChild(statCard(data.guestbook_total, 'Guestbook entries'));
        target.appendChild(statCard(data.unread_messages, 'Unread messages'));
      }

      function makeTable(headers) {
        var table = el('table', 'admin-table');
        var thead = document.createElement('thead');
        var row = document.createElement('tr');
        headers.forEach(function (label) {
          row.appendChild(el('th', '', label));
        });
        thead.appendChild(row);
        table.appendChild(thead);
        var tbody = document.createElement('tbody');
        table.appendChild(tbody);
        return { table: table, body: tbody };
      }

      function actionButton(label, className, handler) {
        var button = el('button', className || 'btn btn--small', label);
        button.type = 'button';
        button.addEventListener('click', handler);
        return button;
      }

      function reload() {
        return api('/api/admin/overview')
          .then(function (data) {
            overview = data;
            showApp();
            renderStats(data.stats);
            renderGuestbook(data.guestbook);
            renderMessages(data.messages);
            renderPages(data.pages);
            setStatus(adminStatus, '', '');
          })
          .catch(function (error) {
            setStatus(adminStatus, error.message, 'error');
          });
      }

      function renderGuestbook(entries) {
        var target = document.getElementById('guestbook-table');
        target.textContent = '';
        if (!entries.length) {
          target.appendChild(el('p', 'gb-empty', 'No entries.'));
          return;
        }
        var built = makeTable(['When', 'Name', 'Note', 'Status', 'Actions']);
        entries.forEach(function (entry) {
          var tr = document.createElement('tr');
          tr.appendChild(el('td', '', formatTime(entry.created_at)));
          var nameCell = document.createElement('td');
          nameCell.appendChild(el('div', '', entry.name));
          if (entry.website) {
            var link = el('a', '', entry.website);
            link.href = entry.website;
            link.target = '_blank';
            link.rel = 'nofollow ugc noopener';
            link.style.fontSize = '11px';
            nameCell.appendChild(link);
          }
          tr.appendChild(nameCell);
          tr.appendChild(el('td', 'admin-message', entry.message));
          var statusCell = document.createElement('td');
          statusCell.appendChild(
            el('span', 'pill ' + (entry.status === 'published' ? 'pill--live' : 'pill--pending'), entry.status)
          );
          tr.appendChild(statusCell);

          var actions = el('td');
          var group = el('div', 'admin-actions');
          if (entry.status !== 'published') {
            group.appendChild(
              actionButton('Publish', 'btn btn--small', function () {
                setGuestbookStatus(entry.id, 'published');
              })
            );
          }
          if (entry.status !== 'hidden') {
            group.appendChild(
              actionButton('Hide', 'btn btn--small', function () {
                setGuestbookStatus(entry.id, 'hidden');
              })
            );
          }
          group.appendChild(
            actionButton('Delete', 'btn btn--small btn--danger', function () {
              if (window.confirm('Delete this entry permanently?')) deleteGuestbook(entry.id);
            })
          );
          actions.appendChild(group);
          tr.appendChild(actions);

          built.body.appendChild(tr);
        });
        target.appendChild(built.table);
      }

      function setGuestbookStatus(id, status) {
        api('/api/admin/guestbook/' + id, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: status }),
        })
          .then(reload)
          .catch(function (error) {
            setStatus(adminStatus, error.message, 'error');
          });
      }

      function deleteGuestbook(id) {
        api('/api/admin/guestbook/' + id, { method: 'DELETE' })
          .then(reload)
          .catch(function (error) {
            setStatus(adminStatus, error.message, 'error');
          });
      }

      function renderMessages(entries) {
        var target = document.getElementById('messages-table');
        target.textContent = '';
        if (!entries.length) {
          target.appendChild(el('p', 'gb-empty', 'No messages.'));
          return;
        }
        var built = makeTable(['When', 'From', 'Message', 'Read', 'Actions']);
        entries.forEach(function (entry) {
          var tr = document.createElement('tr');
          tr.appendChild(el('td', '', formatTime(entry.created_at)));
          var from = document.createElement('td');
          from.appendChild(el('div', '', entry.name));
          if (entry.email) {
            var mail = el('a', '', entry.email);
            mail.href = 'mailto:' + entry.email;
            mail.style.fontSize = '11px';
            from.appendChild(mail);
          }
          tr.appendChild(from);
          tr.appendChild(el('td', 'admin-message', entry.message));
          tr.appendChild(el('td', '', entry.is_read ? 'read' : 'unread'));
          var actions = el('td');
          var group = el('div', 'admin-actions');
          if (!entry.is_read) {
            group.appendChild(
              actionButton('Mark read', 'btn btn--small', function () {
                api('/api/admin/messages/' + entry.id + '/read', { method: 'POST' })
                  .then(reload)
                  .catch(function (error) {
                    setStatus(adminStatus, error.message, 'error');
                  });
              })
            );
          }
          group.appendChild(
            actionButton('Delete', 'btn btn--small btn--danger', function () {
              if (window.confirm('Delete this message permanently?')) {
                api('/api/admin/messages/' + entry.id, { method: 'DELETE' })
                  .then(reload)
                  .catch(function (error) {
                    setStatus(adminStatus, error.message, 'error');
                  });
              }
            })
          );
          actions.appendChild(group);
          tr.appendChild(actions);
          built.body.appendChild(tr);
        });
        target.appendChild(built.table);
      }

      function renderPages(pages) {
        var target = document.getElementById('pages-table');
        target.textContent = '';
        if (!pages.length) {
          target.appendChild(el('p', 'gb-empty', 'No page views recorded yet.'));
          return;
        }
        var built = makeTable(['Path', 'Views', 'Updated']);
        pages.forEach(function (page) {
          var tr = document.createElement('tr');
          tr.appendChild(el('td', '', page.path));
          tr.appendChild(el('td', '', String(page.count)));
          tr.appendChild(el('td', '', formatTime(page.updated_at)));
          built.body.appendChild(tr);
        });
        target.appendChild(built.table);
      }

      loginForm.addEventListener('submit', function (event) {
        event.preventDefault();
        var button = loginForm.querySelector('button[type="submit"]');
        var password = document.getElementById('password').value;
        button.disabled = true;
        setStatus(loginStatus, '', '');

        api('/api/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: password }),
        })
          .then(function () {
            loginForm.reset();
            reload();
          })
          .catch(function (error) {
            setStatus(loginStatus, error.message, 'error');
          })
          .finally(function () {
            button.disabled = false;
          });
      });

      document.querySelectorAll('[data-tab]').forEach(function (button) {
        button.addEventListener('click', function () {
          var target = button.getAttribute('data-tab');
          document.querySelectorAll('[data-tab]').forEach(function (other) {
            other.setAttribute('aria-selected', other === button ? 'true' : 'false');
          });
          document.querySelectorAll('[data-panel]').forEach(function (panel) {
            panel.hidden = panel.getAttribute('data-panel') !== target;
          });
        });
      });

      document.getElementById('logout').addEventListener('click', function () {
        api('/api/admin/logout', { method: 'POST' })
          .catch(function () {})
          .finally(function () {
            showLogin();
            setStatus(loginStatus, 'Signed out.', 'ok');
          });
      });

      api('/api/admin/session')
        .then(function (data) {
          if (data && data.authenticated) {
            reload();
          } else {
            showLogin();
          }
        })
        .catch(function () {
          showLogin();
        });
    })();
  </script>
</Base>
