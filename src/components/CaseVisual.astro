        <svg viewBox="0 0 800 320" role="img" aria-labelledby="drain-title drain-desc">
          <title id="drain-title">Storm-drain prototype schematic</title>
          <desc id="drain-desc">
            A solar panel and battery power an Arduino over a relay to a crusher under a
            funnel-shaped drain insert. A matrix of through-beam sensors detects debris.
          </desc>
          <g fill="none" stroke="var(--ink)" stroke-width="1.4">
            <path d="M20 62 H780" />
            <path d="M300 62 H470" stroke-width="3" />
            <path d="M300 62 V90 H470 V62" />
            <path d="M306 90 L392 150 L408 150 L494 90" />
            <path d="M392 150 L392 205 M408 150 L408 205" />
            <path d="M392 205 L420 230 L380 230 Z" stroke="var(--accent)" />
            <path d="M250 230 L392 230 L470 230 L560 230" stroke-dasharray="4 5" />
            <path d="M250 268 L560 268" stroke-dasharray="4 5" />
          </g>
          <g stroke="var(--accent)" stroke-width="1.2" fill="none">
            <path d="M318 112 H452" />
            <path d="M318 124 H452" />
            <path d="M318 136 H452" />
          </g>
          <g fill="var(--accent)">
            <rect x="314" y="109" width="5" height="6" />
            <rect x="451" y="109" width="5" height="6" />
            <rect x="314" y="121" width="5" height="6" />
            <rect x="451" y="121" width="5" height="6" />
            <rect x="314" y="133" width="5" height="6" />
            <rect x="451" y="133" width="5" height="6" />
          </g>
          <g fill="none" stroke="var(--ink)" stroke-width="1.2">
            <rect x="80" y="34" width="118" height="34" />
            <path d="M92 42 L186 42 M92 50 L186 50 M92 58 L186 58" stroke-width="0.8" />
            <path d="M120 68 V105" />
            <rect x="96" y="105" width="62" height="30" />
            <path d="M158 120 H210 V240 H520 V120 H540" />
            <rect x="540" y="92" width="112" height="50" />
            <rect x="540" y="160" width="112" height="42" />
            <path d="M596 142 V160" />
            <path d="M596 202 V230 H470" />
            <path d="M470 230 V215 H424" />
          </g>
          <g font-family="var(--mono)" font-size="10" fill="var(--muted)" letter-spacing="0.5">
            <text x="80" y="22">SOLAR + BATTERY</text>
            <text x="540" y="82">ARDUINO UNO / MIXLY</text>
            <text x="552" y="186">RELAY</text>
            <text x="430" y="190">CRUSHER</text>
            <text x="482" y="52">EXISTING GRATE</text>
            <text x="298" y="170" text-anchor="end" fill="var(--accent)">SENSOR MATRIX</text>
            <text x="250" y="258">FLOW</text>
            <text x="250" y="294">EXISTING PIPE</text>
          </g>
          <g stroke="var(--accent)" stroke-width="1.2" fill="none">
            <path d="M232 248 H282" />
            <path d="M276 244 L282 248 L276 252" />
            <path d="M306 160 L318 142" />
            <path d="M420 205 L426 196" />
