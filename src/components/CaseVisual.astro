<style>
  .mock-browser {
    border: 1px solid var(--line-strong);
    background: var(--paper);
  }

  .mock-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--line);
    background: var(--surface-sunk);
  }

  .mock-bar > span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .mock-url {
    margin-left: 10px;
    padding: 3px 10px;
    border: 1px solid var(--line);
    background: var(--surface);
    font-family: var(--mono);
    font-size: 9px;
    color: var(--muted);
    letter-spacing: 0.05em;
  }

  .mock-page {
    padding: 28px 30px;
    font-family: var(--serif);
    font-size: 1.12rem;
    line-height: 2.4;
    color: var(--ink-soft);
  }

  .mock-page p + p {
    margin-top: 8px;
  }

  ruby {
    ruby-align: center;
  }

  rt {
    font-family: var(--sans);
    font-size: 9px;
    color: var(--accent);
    letter-spacing: 0.02em;
    opacity: 0.85;
  }

  .mock-dim {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.7;
    font-style: italic;
  }

  .mock-chat {
    display: grid;
    gap: 14px;
    padding: 6px 0;
  }

  .mock-line {
    max-width: 88%;
    padding: 14px 16px;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .mock-line--you {
    margin-left: auto;
    background: var(--accent-soft);
    border-color: color-mix(in srgb, var(--accent) 30%, var(--line));
  }

  .mock-tag {
    display: block;
    margin-bottom: 7px;
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  .mock-line p {
    font-family: var(--serif);
